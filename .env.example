# Supabase PostgreSQL — URL pooled para o runtime e URL directa para migrations.
# Substitui PROJECT_REF e PASSWORD; codifica caracteres especiais da password na URL.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require"
DIRECT_URL="postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require"
DATABASE_POOL_MAX=5

# NextAuth (gera com: openssl rand -base64 32). Mantém o mesmo valor entre deploys.
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="SUBSTITUI_POR_UM_SEGREDO_LONGO_ALEATORIO"

# Opcional: Google OAuth. Cria um OAuth Web Client no Google Cloud.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
APP_URL="http://localhost:3000"

# Cifra AES-256-GCM para tokens Meta guardados por empresa.
# Gera com: openssl rand -base64 32 (a chave descodificada tem de ter 32 bytes).
ENCRYPTION_KEY="SUBSTITUI_POR_UMA_CHAVE_BASE64_DE_32_BYTES"

# Webhook oficial Meta / WhatsApp Cloud API.
META_APP_SECRET="SEGREDO_DA_META_APP_PARA_VALIDAR_ASSINATURAS"
META_GRAPH_API_VERSION="v23.0"
META_TASK_TEMPLATE_NAME="executapro_tarefa"
META_TEMPLATE_LANGUAGE="pt_PT"

# Protege os endpoints /api/cron/* (gera outro segredo aleatório).
CRON_SECRET="SUBSTITUI_POR_UM_SEGREDO_LONGO_ALEATORIO"
