# Opcional: protege a verificação GET do webhook Meta.
# Define o mesmo valor no painel da Meta e no ambiente do servidor.
META_WEBHOOK_VERIFY_TOKEN=altera-este-token-local

# Opcional em desenvolvimento; obrigatório em produção para validar assinaturas
# X-Hub-Signature-256 dos POSTs do webhook.
META_APP_SECRET=altera-para-o-segredo-da-tua-app-meta
